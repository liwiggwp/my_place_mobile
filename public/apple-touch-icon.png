<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ff758c" />
      <stop offset="50%" stop-color="#ff7eb3" />
      <stop offset="100%" stop-color="#70a6ff" />
    </linearGradient>
    <linearGradient id="moonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#fff0f5" />
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#ff4b72" flood-opacity="0.35"/>
    </filter>
  </defs>
  
  <!-- Rounded Squircle Background (iOS App Icon Shape) -->
  <rect width="512" height="512" rx="120" fill="url(#bgGrad)" />
  
  <!-- Subtle inner glow / decorative circle -->
  <circle cx="256" cy="256" r="190" fill="none" stroke="#ffffff" stroke-opacity="0.25" stroke-width="6" stroke-dasharray="16 12"/>
  
  <!-- Stylized Crescent Moon & Flower/Drop Centerpiece -->
  <g filter="url(#shadow)">
    <!-- Crescent Moon -->
    <path d="M 285 130 C 205 130 145 190 145 270 C 145 350 210 410 290 410 C 325 410 355 398 380 378 C 300 375 240 310 240 235 C 240 185 265 145 285 130 Z" fill="url(#moonGrad)" />
    
    <!-- Water Drop / Petal Accent -->
    <path d="M 335 220 C 335 220 370 265 370 290 C 370 310 354 326 335 326 C 316 326 300 310 300 290 C 300 265 335 220 335 220 Z" fill="#ffffff" opacity="0.95" />
    
    <!-- Sparkle -->
    <path d="M 215 175 Q 215 195 195 195 Q 215 195 215 215 Q 215 195 235 195 Q 215 195 215 175 Z" fill="#ffffff" />
    <path d="M 365 160 Q 365 172 353 172 Q 365 172 365 184 Q 365 172 377 172 Q 365 172 365 160 Z" fill="#ffffff" opacity="0.9" />
  </g>
</svg>